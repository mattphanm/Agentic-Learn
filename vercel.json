{
  "functions": {
    "server.js": {
      "includeFiles": [
        "index.html",
        "styles.css",
        "script.js",
        "public/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/waitlist",
      "dest": "/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/server.js"
    }
  ]
}
